HOS_EXECUTOR=mock
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
HOS_DEFAULT_MODEL=gpt-4.1-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
HOS_FREE_TIER_MODE=true
HOS_MAX_AGENT_CALLS=5
HOS_MAX_RETRIES=1
GEMINI_MAX_OUTPUT_TOKENS_DEFAULT=2048
GEMINI_MAX_OUTPUT_TOKENS_CEO=3000
# Legacy override; prefer GEMINI_MAX_OUTPUT_TOKENS_*
HOS_MAX_OUTPUT_TOKENS_PER_AGENT=
HOS_MAX_TOTAL_TOKENS=
HOS_DAILY_RUN_LIMIT=
HOS_MAX_PARALLEL_AGENTS=3
HOS_MAX_RUN_COST=

# Stock Watch V2
DISCORD_NOTIFY_NO_ALERT=false
JPX_TOPIX_CSV_URL=

# Stock Watch V3 private order-planning inputs
# Put actual amounts in GitHub Actions Secrets, not in this public file.
HOS_EXECUTION_ACCOUNT=maho
HOS_MAHO_BUYING_POWER_JPY=
HOS_HIRO_BUYING_POWER_JPY=
HOS_MONTHLY_STOCK_BUDGET_REMAINING_JPY=
HOS_ANNUAL_STOCK_BUDGET_REMAINING_JPY=
HOS_MAX_SINGLE_ORDER_JPY=
HOS_ALLOW_ODD_LOT=true
HOS_STRATEGY_MAX_DAILY_ORDERS=1
HOS_USDJPY_PLANNING_RATE=160

# Registered household strategy private funding values
HOS_HOUSEHOLD_AVAILABLE_CASH_JPY=
HOS_TARGET_INVESTMENT_TO_2027_03_JPY=
HOS_RESERVE_AFTER_EXECUTION_JPY=
HOS_MAHO_2026_STOCK_CAP_JPY=
HOS_MAHO_STRATEGY_BUDGET_JPY=
HOS_HIRO_STRATEGY_BUDGET_JPY=

# Investment Fact Pipeline: network facts are opt-in; no paid fallback.
HOS_ENABLE_NETWORK_FACTS=false

# Verified investment fact pipeline (free-tier safe)
HOS_FACT_MODE=cached_only
HOS_ENABLE_NETWORK_FACTS=false
HOS_FACT_PACK_ONLY=false
HOS_VERIFIED_LITE_MAX_CALLS=2
HOS_MAX_VERIFIED_ANALYSES_PER_DAY=3
HOS_MAX_AGENT_CALLS=2
EDINET_API_KEY=
