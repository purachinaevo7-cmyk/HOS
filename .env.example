# Service credentials only. Keep this file empty of real values.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
GEMINI_API_KEY=
EDINET_API_KEY=
DISCORD_WEBHOOK_URL=
# Public-data-only Japanese dividend screener. Use a separate Discord channel.
DIVIDEND_SCREENER_DISCORD_WEBHOOK_URL=

# HOS Stock Watch: the single source for household data. In GitHub Actions set
# this as the HOS_PRIVATE_PROFILE_JSON secret; never commit or print it.
HOS_PRIVATE_PROFILE_JSON=

# Non-sensitive runtime controls. Private values are inside the profile.
HOS_ENABLE_NETWORK_FACTS=false
HOS_FACT_MODE=cached_only
HOS_FACT_PACK_ONLY=false
HOS_VERIFIED_LITE_MAX_CALLS=2
HOS_MAX_VERIFIED_ANALYSES_PER_DAY=3
HOS_MAX_AGENT_CALLS=2
HOS_MAX_RETRIES=1
HOS_STRATEGY_MAX_DAILY_ORDERS=1
HOS_USDJPY_PLANNING_RATE=160
