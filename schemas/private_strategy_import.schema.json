{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HOS Private Strategy Import",
  "description": "Secret-only migration envelope. Never commit a populated instance.",
  "type": "object",
  "required": ["version", "source_account_ids", "strategy"],
  "properties": {
    "version": {"const": 1},
    "source_account_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "strategy": {
      "type": "object",
      "required": ["strategy_id", "status", "purchase_authority", "accounts"],
      "properties": {
        "accounts": {"type": "object"}
      }
    }
  }
}
